# =============================================================================
# CONLINEWEB - ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO (.env.example)
# Copia este archivo a .env y asigna los valores correspondientes
# =============================================================================

# --- ENTORNO ---
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=tu_clave_secreta_aqui
JWT_SECRET_KEY=tu_clave_secreta_jwt_aqui
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- BASE DE DATOS PRINCIPAL (admin_clientes / MariaDB) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=admin_clientes
DB_PASS=tu_password_db
DB_NAME=admin_clientes
DATABASE_URL=mysql+pymysql://usuario:password@localhost:3306/admin_clientes?charset=utf8mb4

# --- BASE DE DATOS HOSTINGPRO ---
DB_HOST_HP=localhost
DB_PORT_HP=3306
DB_USER_HP=conlineweb_hosting
DB_PASS_HP=tu_password_hp
DB_NAME_HP=conlineweb_hosting
DATABASE_URL_HP=mysql+pymysql://usuario:password@localhost:3306/conlineweb_hosting?charset=utf8mb4

# --- BASE DE DATOS LOCAL / PRUEBA LEGACY ---
DB_HOST_LEGACY=localhost
DB_USER_LEGACY=admin_conline_website
DB_PASS_LEGACY=tu_password_legacy
DB_NAME_LEGACY=admin_conline_website

# --- BACKEND API (FastAPI) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- FRONTEND (Vite / Vue 3) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- CORREO SALIENTE (SMTP / PHPMailer) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_AUTH=true
SMTP_USER=servicios@conlineweb.com
SMTP_PASS=tu_app_password_google
SMTP_FROM_EMAIL=servicios@conlineweb.com
SMTP_FROM_NAME=ConlineWeb

# --- STRIPE PAGOS ---
STRIPE_TEST_MODE=true
STRIPE_SECRET_KEY=sk_live_...
STRIPE_TEST_SECRET_KEY=sk_test_...
STRIPE_SECRET_KEY_HOSTPRO=
STRIPE_WEBHOOK_SECRET=whsec_...

# --- GOOGLE RECAPTCHA v2 ---
CW_RECAPTCHA_SITE_KEY=tu_site_key_aqui
CW_RECAPTCHA_SECRET=tu_secret_key_aqui
CW_HUB_RECAPTCHA_SITE_KEY=tu_site_key_aqui
CW_HUB_RECAPTCHA_SECRET=tu_secret_key_aqui

# --- SEGURIDAD SSO / PORTAL ---
CW_PORTAL_SSO_SECRET=tu_portal_sso_secret_aqui
CW_HUB_API_KEY=tu_hub_api_key_aqui
CW_HUB_WHATSAPP=5214771181285

# --- FACEBOOK ADS / LEADS ---
FACEBOOK_PAGE_ID=tu_page_id_aqui
FACEBOOK_ACCESS_TOKEN=tu_access_token_aqui
FACEBOOK_API_VERSION=v24.0
